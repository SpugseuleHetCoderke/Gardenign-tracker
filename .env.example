# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Postgres connection string from Neon (https://neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Resend API key for reminder emails (https://resend.com) — optional, only
# needed if you want the email-reminder backup alongside push notifications.
RESEND_API_KEY=""

# Who reminder emails are sent from. Must be an address on a domain verified
# in Resend. Resend's shared sandbox sender (onboarding@resend.dev) only
# delivers to your own Resend account email — fine for testing, not for
# sending to someone else.
# The recipient address is NOT set here — it's chosen in the app itself,
# under Instellingen, and stored in the database.
REMINDER_FROM="Garden <onboarding@resend.dev>"

# Shared secret so only the scheduler can trigger the reminder endpoint.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# Web push (Android/Chrome notifications). Generate a pair with:
#   npx web-push generate-vapid-keys
# The public key is safe to expose to the browser; keep the private key secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
